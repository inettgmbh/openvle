#: controllers/object_permissions.py:177
msgid "An ObjectPermission with this exact combination already exists."
msgstr "Eine Objektberechtigung mit genau dieser Kombination existiert bereits."

#: controllers/object_permissions.py:220
msgid "The ObjectPermission '{permission_key}' already exists for this object."
msgstr ""
"Die Objektberechtigung '{permission_key}' existiert für dieses Objekt "
"bereits."

#: controllers/object_permissions.py:238
msgid "An 'object_create' permission already exists for this object."
msgstr "Eine 'object_create'-Berechtigung existiert für dieses Objekt bereits."

#: controllers/object_permissions.py:252
msgid ""
"Cannot add 'object_create' when multiple CRUD permissions already exist. "
"Only one CRUD permission can coexist with object_create."
msgstr ""
"'object_create' kann nicht hinzugefügt werden, wenn bereits mehrere "
"Berechtigungen existieren. Nur eine Berechtigung kann zusammen mit "
"object_create bestehen."

#: controllers/object_permissions.py:277
msgid ""
"Cannot add another CRUD permission. When 'object_create' exists, only one"
" other CRUD permission is allowed."
msgstr ""
"Es kann keine weitere Berechtigung hinzugefügt werden. Wenn "
"'object_create' existiert, ist nur eine weitere Berechtigung zulässig."

#: controllers/object_permissions.py:296
msgid ""
"The {entity_type} already has a CRUD permission for {object_type} "
"({object_display}). Only one CRUD permission per object is allowed, "
"except when combining object_create with one other CRUD permission."
msgstr ""
"{entity_type} hat bereits eine Berechtigung für {object_type} "
"({object_display}). Pro Objekt ist nur eine Berechtigung zulässig, außer "
"bei der Kombination von object_create mit einer weiteren Berechtigung."

#: controllers/policies.py:134
