#: controllers/object_permissions.py:178
msgid "An ObjectPermission with this exact combination already exists."
msgstr "Ya existe un permiso de objeto con esta combinación exacta."

#: controllers/object_permissions.py:221
#, python-brace-format
msgid "The ObjectPermission '{permission_key}' already exists for this object."
msgstr "El permiso de objeto '{permission_key}' ya existe para este objeto."

#: controllers/object_permissions.py:239
msgid "An 'object_create' permission already exists for this object."
msgstr "Ya existe un permiso 'object_create' para este objeto."

#: controllers/object_permissions.py:253
msgid ""
"Cannot add 'object_create' when multiple CRUD permissions already exist. "
"Only one CRUD permission can coexist with object_create."
msgstr ""
"No se puede añadir 'object_create' cuando ya existen múltiples permisos "
"CRUD. Solo un permiso CRUD puede coexistir con object_create."

#: controllers/object_permissions.py:278
msgid ""
"Cannot add another CRUD permission. When 'object_create' exists, only one"
" other CRUD permission is allowed."
msgstr ""
"No se puede añadir otro permiso CRUD. Cuando 'object_create' existe, solo"
" se permite un permiso CRUD adicional."

#: controllers/object_permissions.py:297
#, python-brace-format
msgid ""
"The {entity_type} already has a CRUD permission for {object_type} "
"({object_display}). Only one CRUD permission per object is allowed, "
"except when combining object_create with one other CRUD permission."
msgstr ""
"{entity_type} ya tiene un permiso CRUD para {object_type} "
"({object_display}). Solo se permite un permiso CRUD por objeto, excepto "
"al combinar object_create con otro permiso CRUD."

